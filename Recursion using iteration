#include <stdio.h>
int main() {
int n, factorial;
printf("Enter a non-negative integer: ");
scanf("%d", &n);
if (n < 0) {
printf("Factorial is not defined for negative numbers");
} else if (n == 0) {
printf("Factorial of 0 is 1");
} else {
factorial=1;
for (int i = 1 ; i <= n; i++) {
factorial *= i;
}
printf("Factorial of %d is %llu.", n, factorial);
}
return 0;
}
